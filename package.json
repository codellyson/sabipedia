{
  "name": "wikihownaija",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3100",
    "build": "nuxt build",
    "preview": "wrangler dev --port 8788",
    "typecheck": "nuxt typecheck",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types",
    "db:seed": "node --experimental-strip-types tools/seed.mjs",
    "db:clear-demo": "node tools/clear-demo.mjs",
    "scrape": "node tools/scrape.mjs",
    "scrape:community": "node tools/scrape-community.mjs && node tools/import-community.mjs",
    "scrape:food": "node tools/scrape-food.mjs && node --experimental-strip-types tools/import-food.mjs",
    "scrape:food:batch": "node tools/scrape-food-batch.mjs && node --experimental-strip-types tools/import-food-batch.mjs",
    "db:import-community": "node tools/import-community.mjs",
    "db:import-food": "node --experimental-strip-types tools/import-food.mjs",
    "db:import-food-batch": "node --experimental-strip-types tools/import-food-batch.mjs",
    "db:preseed": "node --experimental-strip-types tools/preseed.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/ui": "^4.11.2",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "better-auth": "^1.7.6",
    "nuxt": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.0.0",
    "auth": "^1.7.6",
    "cheerio": "^1.2.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
